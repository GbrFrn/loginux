[Unit]
Description=Loginux: keep the chosen lighting profile applied, with a tray icon
Documentation=https://github.com/GbrFrn/loginux

[Service]
# `cargo install --path .` puts the binary here; the Arch package installs this
# unit with /usr/bin/loginux instead.
ExecStart=%h/.cargo/bin/loginux run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
