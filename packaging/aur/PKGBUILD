# Maintainer: GbrFrn <GbrFrn@users.noreply.github.com>

pkgname=loginux-git
_pkgname=loginux
pkgver=0.1.0.r6.g5ed2629
pkgrel=1
pkgdesc='RGB lighting for Logitech HID++ keyboards and mice, with a tray icon'
arch=('x86_64' 'aarch64')
url='https://github.com/GbrFrn/loginux'
license=('MIT OR Apache-2.0')
# The window and the tray load these at run time (dlopen), so ldd does not list them.
depends=(
  'gcc-libs'
  'glibc'
  'hicolor-icon-theme'
  'libglvnd'
  'libx11'
  'libxcb'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxkbcommon-x11'
  'libxrender'
  'wayland'
)
makedepends=('cargo' 'git')
provides=("$_pkgname")
conflicts=("$_pkgname")
install=loginux.install
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  printf '%s.r%s.g%s' \
    "$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Panic messages name generated sources under target/; keep the build path out.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/build"
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/loginux -t "$pkgdir/usr/bin/"
  install -Dm644 udev/70-loginux.rules -t "$pkgdir/usr/lib/udev/rules.d/"
  install -d "$pkgdir/usr/lib/systemd/user"
  sed 's|%h/.cargo/bin/loginux|/usr/bin/loginux|' systemd/loginux.service \
    > "$pkgdir/usr/lib/systemd/user/loginux.service"
  install -Dm644 packaging/loginux.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 icons/loginux.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  for size in 16 32 48 64 128 256; do
    install -Dm644 "icons/loginux-$size.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/loginux.png"
  done
  install -Dm644 LICENSE-MIT LICENSE-APACHE fonts/OFL-*.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
