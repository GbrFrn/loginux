#!/bin/sh
# Stand-in for `systemctl --user ...` in Loginux's tests (src/testenv.rs). Its
# files live in $LOGINUX_TEST_SYSTEMD: every call is logged; `is-enabled`
# answers from `state`, which `enable` and `disable` change, and without it
# says `not-found` with exit 4, as systemd 262 does for a missing unit; both
# fail while a `fails` file exists, and wait while a `hold` file exists.
cd "${LOGINUX_TEST_SYSTEMD:?set by the tests}" || exit 1
echo "$*" >> log
case "$*" in
*is-enabled*) if [ -f state ]; then cat state; exit 0; fi; echo not-found; exit 4 ;;
esac
while [ -f hold ]; do sleep 0.05; done
if [ -f fails ]; then echo "Failed to $2 loginux.service" >&2; exit 1; fi
case "$*" in
*" enable "*) echo enabled > state ;;
*" disable "*) echo disabled > state ;;
esac
